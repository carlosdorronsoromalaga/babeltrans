# Babel Translations — configuración de Apache (Webempresa usa Apache/LiteSpeed)

# Siempre por https y con www, como la web original
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.babeltrans.es%{REQUEST_URI} [L,R=301]

# La portada en castellano tenía dos direcciones; se queda una
RedirectMatch 301 ^/es\.html$ /
RedirectMatch 301 ^/index\.php$ /

DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>

# Páginas retiradas en la web nueva (CV y CP)
RedirectMatch 301 ^/es/cv\-ingles\.html$ /es/solicite-presupuesto-traduccion/presupuesto-traduccion.html
RedirectMatch 301 ^/es/cp\-ingles\-aleman\.html$ /es/solicite-presupuesto-traduccion/presupuesto-traduccion.html
RedirectMatch 301 ^/en/cv\-ingles\.html$ /en/request-a-quote/translation-quote.html
RedirectMatch 301 ^/en/cp\-ingles\-aleman\.html$ /en/request-a-quote/translation-quote.html
RedirectMatch 301 ^/de/cv\-ingles\.html$ /de/kostenvoranschlag/kostenvoranschlag-uebersetzen.html
RedirectMatch 301 ^/de/cp\-ingles\-aleman\.html$ /de/kostenvoranschlag/kostenvoranschlag-uebersetzen.html
RedirectMatch 301 ^/nl/vertalen\-cv\.html$ /nl/vrijblijvende-offerte/vertaalofferte.html
RedirectMatch 301 ^/nl/cp\-ingles\-aleman\.html$ /nl/vrijblijvende-offerte/vertaalofferte.html

